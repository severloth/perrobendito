# --- Base de datos (Neon) --------------------------------------------------
# DATABASE_URL: connection string CON pooling (termina en -pooler). La usan las
# funciones serverless, que abren y cierran conexiones todo el tiempo.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: la misma base SIN pooler. Solo la usan las migraciones.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Sesion del admin ------------------------------------------------------
# Secreto para firmar la cookie de sesion. Generar uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# --- Usuario admin inicial (lo crea el seed) -------------------------------
ADMIN_EMAIL="hola@perrobenditoestudio.com"
ADMIN_PASSWORD="cambiar-antes-de-produccion"

# --- Vercel Blob -----------------------------------------------------------
# La agrega Vercel sola al crear el store. En local, copiarla de la dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
